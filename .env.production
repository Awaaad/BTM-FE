# Baked into the build by `npm run build`.

# The backend's context path, as reachable from the browser on the deployed site.
# Same host (reverse proxy or same Tomcat): "/btm"
# Different host: a full origin, e.g. "https://api.example.com/btm" — the backend's
# app.cors.allowed-origins must then include this site's origin.
VITE_API_BASE=/btm

# Set this if the built files are served from a sub-folder rather than the web
# root, e.g. VITE_BASE_PATH=/btm-ui/ — otherwise the JS and CSS 404.
# VITE_BASE_PATH=/
